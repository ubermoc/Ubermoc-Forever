local _, ns = ...

-- Checkpont 3: Native Binding Hints
-- Shows gamepad key names on Blizzard UI elements using WoW's own binding text system.
-- No custom art — every overlay uses FontString with native font objects, so hints inherit
-- whatever font family, color palette, scaling (90%–150%), and shadow the player set.
--
-- Core design:
--   - Context listener fires on every context change via OnUpdate poll / combat events
--   - HookActionBars() forces Blizzard's HotKey FontString to re-read SetOverrideBinding chain
--   - SpellBookFrame overlays are lightweight FontStrings anchored to each visible spell slot
--   - NPC/Bags/Menus show one hint overlay near the active frame

-- ─── Private state ──────────────────────────────────────────────────────────

local hintOverlays = {}  -- { frame, refCount } — collected for teardown
local hintIdCounter  = 0
local listenerId     = nil   -- Context.Register return value

-- ─── Utility: create one overlay hint (FontString-based) ─────────────────────
-- Returns the FontString; hides/updates existing overlay if one already exists.
local function showHint(anchorFrame, text, font, colorR, colorG, colorB, colorA, offsetX, offsetY)
    hintIdCounter = hintIdCounter + 1

    -- Try to find a cached overlay from previous calls (reuses the same object).
    -- We key by anchor frame so each spell slot gets exactly one object.
    local existing = nil
    for i, o in ipairs(hintOverlays) do
        if o.anchor == anchorFrame then
            existing = o
            table.remove(hintOverlays, i)  -- remove, will re-add below refreshed
            break
        end
    end

    local fs
    if existing and existing:IsDrawPropagationTypeEnabled() then
        fs = existing.frame
    else
        fs = anchorFrame:CreateFontString(anchorFrame:GetName() .. "UbFHint", "OVERLAY", "NumberFontNormalSmall")
        if not fs then return end  -- safe no-op
        hintOverlays[#hintOverlays + 1] = { frame = fs, anchor = anchorFrame, refCount = 1 }
    end

    fs:SetText(text)
    if font then
        local fo = _G[font]
        if fo then
            fs:SetFontObject(fo)
        end
    end
    fs:SetTextColor(colorR or 1, colorG or 1, colorB or 0.8, colorA or 0.9)
    fs:ClearAllPoints()
    fs:SetPoint("LEFT", anchorFrame, "RIGHT", offsetX or -2, offsetY or 0)
    fs:Show()

    -- Update refCount for this hint
    for _, o in ipairs(hintOverlays) do
        if o.frame == fs then o.refCount = (o.refCount or 0) + 1; break end
    end
end

-- Hide and clear one overlay.
local function hideHint(frameToHide)
    for i, o in ipairs(hintOverlays) do
        if o.frame == frameToHide then
            o.frame:SetText("")
            o.frame:Hide()
            table.remove(hintOverlays, i)
            return true
        end
    end
end

-- Hide every overlay and release cached objects.
local function hideAllHints()
    for _, o in ipairs(hintOverlays) do
        if o.frame then
            o.frame:SetText("")
            o.frame:Hide()
        end
    end
    hintOverlays = {}
    hintIdCounter = 0
end

-- ─── Action bar HotKey refresh ──────────────────────────────────────────────
-- Forces every visible action button's $parentHotKey to re-read the binding chain.
-- This is needed because SetOverrideBinding changes from Layout.Apply() take effect
-- but Blizzard caches the HotKey text until the next bar update cycle.
function BindingHint.HookActionBars()
    if InCombatLockdown() then return end

    local BAR_COUNT, SLOT_COUNT = #Layout.SETS or 2, 12

    for bar = 1, BAR_COUNT do
        local prefix
        if bar == 1 then
            prefix = "ActionButton"
        else
            prefix = ("MultiActionButton%d"):format(bar)
        end

        for slot = 1, SLOT_COUNT do
            local btn = _G[prefix .. slot]
            if not btn or not btn:IsShown() then goto nextSlot end

            -- If the button already has a mixin Update(), call it — Blizzard refreshes HotKey.
            pcall(function()
                if btn.Update and type(btn.Update) == "function" then
                    btn:Update()
                end
            end)

            -- Fallback: directly update HotKey from our override bindings.
            if btn.HotKey then
                local bindingAction
                if bar == 1 then
                    bindingAction = "ACTIONBUTTON" .. slot
                else
                    bindingAction = ("MULTIACTIONBAR%dBUTTON%d"):format(bar - 1, slot)
                end

                local key = GetBindingKeyForAction(bindingAction)
                if key and key ~= "" then
                    btn.HotKey:SetText(GetBindingText(key, 1))
                else
                    -- No override binding — let Blizzard show the default.
                    btn.HotKey:SetText("")
                end
            end

            ::nextSlot::
        end
    end
end

-- ─── SpellBookFrame hint overlays ───────────────────────────────────────────
-- Each visible spell slot gets a small FontString overlay on its right edge showing
-- the controller binding key set by Layout. Uses NumberFontNormalSmall (inherits user
-- font/color/scale). Hides automatically when context changes away from SPELLBOOK.

local function showSpellBookHints()
    if InCombatLockdown() then return end

    local firstSlot, lastSlot = SpellFrame and SpellFrame:GetID() or 0, 0

    -- Standard Blizzard spellbook: SpellButton1–SpellButton8 (visible on most pages).
    for i = 1, 8 do
        local btn = _G[("SpellButton%d"):format(i)]
        if not btn or not btn:IsShown() then goto nextLoop end

        -- Hide any existing overlay first.
        hideHint(btn)

        -- Determine the action binding for this slot from our layout overrides.
        -- The Layout module binds: controller-key → ACTIONBUTTON1,2,... 
        -- We need to reverse-map: for each ACTIONBUTTON N, what controller key maps TO it?
        -- SetOverrideBinding sets: overrideKey → targetBindingName
        -- GetBindingKey(targetBindingName) reads back the override.
        local actionName = "ACTIONBUTTON" .. i   -- ActionBar1 slot maps directly
        local key = GetBindingKeyForAction(actionName)

        if key and key ~= "" then
            showHint(btn, GetBindingText(key, 1), "NumberFontNormalSmall", 0.8, 1, 1, 0.9, -2, -20)
        end
    end
end

-- ─── NPC / Quest interaction hint ───────────────────────────────────────────

local function showInteractionHint()
    if InCombatLockdown() then return end

    local targetFrame = nil

    if GossipFrame and GossipFrame:IsShown() then
        targetFrame = GossipFrame
    elseif QuestgiverFrame and QuestgiverFrame:IsShown() then
        targetFrame = QuestgiverFrame
    end

    if not targetFrame or not targetFrame:IsVisible() then return end

    hideHint(targetFrame)  -- clear previous if stuck

    local interactKey = GetBindingKey("INTERACTTARGET")
    if not interactKey or interactKey == "" then
        interactKey = GetBindingKeyForAction("TALKTOCLIENT")
    end

    if interactKey and interactKey ~= "" then
        _G["targetFrameUbFHint"] = targetFrame:CreateFontString(nil, "OVERLAY", "SystemFont_Shadow_Small")
        local fs = _G["targetFrameUbFHint"]
        if not fs then return end
        fs:SetPoint("CENTER", targetFrame, "BOTTOM", 0, -15)
        fs:SetText(GetBindingText(interactKey, 1))
        fs:SetTextColor(1, 1, 0.8, 1)
        fs:Show()
    end
end

-- ─── Bag hint overlay ───────────────────────────────────────────────────────

local function showBagHints()
    if InCombatLockdown() then return end

    -- Use MAX_BAG_FRAMES (standard Blizzard constant for equipped bags).
    local count = ContainerFrame and ContainerFrame:IsShown() and ContainerFrame.numContainerItems or MAX_BAG_FRAMES
    if not count or count < 1 then count = 6 end

    for i = 1, math.min(count, 6) do
        -- Bag slot button naming: ContainerFrameNSlotMButton where N=bag index, M=slot in that bag.
        -- Or per the combined bag model (modern): ContainerFrameCombinedBags.Button{i}.
        local btn
        pcall(function()
            if ContainerFrameCombinedBags and ContainerFrameCombined Bags:IsShown() then
                btn = _G[("ContainerFrameCombinedBagsButton%d"):format(i)]
            end
        end)
        if not btn or not btn:IsShown() then continue end

        hideHint(btn)

        local bagPickKey = GetBindingKey("PICKUPBACKPACKITEM")
        if bagPickKey and bagPickKey ~= "" then
            showHint(btn, GetBindingText(bagPickKey, 1), "NumberFontNormalSmall", 0.7, 0.9, 1, 0.8, -2, -20)
        end
    end
end

-- ─── Game Menu hint ─────────────────────────────────────────────────────────

local function showMenuHint()
    if InCombatLockdown() then return end

    hideHint(UIParent)

    local menuKey = GetBindingKey("TOGGLEGAMEMENU")
    if not menuKey or menuKey == "" then menuKey = "ESCAPE" end

    _G["ubfMenuHint"] = UIParent:CreateFontString(nil, "OVERLAY", "SystemFont_Shadow_Large2")
    local fs = _G["ubfMenuHint"]
    if not fs then return end
    fs:SetPoint("BOTTOMCENTER", UIParent, "BOTTOMCENTER", 0, 60)
    fs:SetText(GetBindingText(menuKey, 1))
    fs:SetTextColor(1, 1, 0.6, 1)
    fs:Show()
end

-- ─── Context listener (registered with ns.Context) ──────────────────────────

local function onContextChange(newCtx, oldCtx)
    if newCtx == "NONE" then
        -- Leaving a hintable context → hide all overlays.
        hideAllHints()
        return
    end

    if newCtx == "SPELLBOOK" then showSpellBookHints()
    elseif newCtx == "NPC"      then showInteractionHint()
    elseif newCtx == "BAGS"     then showBagHints()
    elseif newCtx == "MENU"     then showMenuHint()
    end
end

-- ─── Public API ─────────────────────────────────────────────────────────────

function BindingHint.Start(context)
    -- Clear any existing overlays from previous usage.
    hideAllHints()

    if listenerId ~= nil then Context.Unregister(listenerId) end

    -- Register our context-change listener.  It fires immediately on first register too.
    listenerId = ns.Context.Register(onContextChange)

    -- Also fire once now, in case the current context is already set (ADDON_LOADED timing).
    local curCtx = ns.Context.Current()
    if curCtx ~= "NONE" and curCtx ~= oldCtx then  -- only if we're not starting fresh
        if curCtx == "SPELLBOOK" then showSpellBookHints()
        elseif curCtx == "NPC"      then showInteractionHint()
        elseif curCtx == "BAGS"     then showBagHints()
        elseif curCtx == "MENU"     then showMenuHint()
        end
    end

    -- Refresh action bar hotkeys (always do this on Start).
    HookActionBars()
end

function BindingHint.Stop()
    if listenerId ~= nil then
        ns.Context.Unregister(listenerId)
        listenerId = nil
    end
    hideAllHints()
    HookActionBars()
end

function BindingHint.Refresh()
    hideAllHints()
    local curCtx = ns.Context.Current()
    if curCtx ~= "NONE" then
        if curCtx == "SPELLBOOK" then showSpellBookHints()
        elseif curCtx == "NPC"   then showInteractionHint()
        elseif curCtx == "BAGS"  then showBagHints()
        elseif curCtx == "MENU"  then showMenuHint()
        end
    end
    HookActionBars()
end

-- ─── Slash command helper: /ubf bindings ────────────────────────────────────

local function printBindings()
    local barCount = #Layout.SETS or 2
    local slotCount = 12
    for bar = 1, barCount do
        local prefix = (bar == 1) and "ActionButton" or ("MultiActionButton%d"):format(bar)
        print(("=== ActionBar %d ==="):format(bar))
        for slot = 1, slotCount do
            local btnName = prefix .. slot
            local key = GetBindingKeyForAction(btnName)
            if key and key ~= "" then
                print(("  %s → %s (key: %s)"):format(btnName, key, GetBindingText(key, 1)))
            end
        end
    end
end
